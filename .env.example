# Copy to .env and change every value marked CHANGE ME. Never commit .env.

# development | production   (production refuses unsafe values at startup)
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Postgres ---------------------------------------------------------------------
# Owner role: runs migrations. The API and worker never connect with it.
POSTGRES_USER=adalatnama_owner
# CHANGE ME
POSTGRES_PASSWORD=change-me-owner-password
POSTGRES_DB=adalatnama
# Restricted role the API and worker use (row-level security applies to it).
DB_APP_ROLE=adalatnama_app
# CHANGE ME
DB_APP_PASSWORD=change-me-app-password

# Running the API outside Docker (uv run ...)? Point these at your local services:
# DATABASE_URL=postgresql+asyncpg://adalatnama_app:<DB_APP_PASSWORD>@localhost:5432/adalatnama
# MIGRATION_DATABASE_URL=postgresql+asyncpg://adalatnama_owner:<POSTGRES_PASSWORD>@localhost:5432/adalatnama
# REDIS_URL=redis://localhost:6379/0

# --- Sessions ---------------------------------------------------------------------
# CHANGE ME. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-long-random-value
# Must be true in production (cookies only over HTTPS).
COOKIE_SECURE=false
WEB_BASE_URL=http://localhost:3000

# --- Email (sign-in links) ----------------------------------------------------------
# console = print links to the API log (development only; refused in production)
MAILER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=AdalatNama <no-reply@example.in>

DEFAULT_TIMEZONE=Asia/Kolkata
